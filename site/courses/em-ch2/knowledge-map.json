        "53": "p53-r1"
      }
    },
    {
      "id": "charge-relaxation",
      "label": "导体自由体电荷的弛豫",
      "pages": [
        36
      ],
      "summary": "均匀简单欧姆媒质中用守恒、高斯与J=σE得到体电荷指数衰减，时间尺度τ=ε/σ。远大于τ时可近似忽略体电荷，不表示有限时刻严格消失，也不排除表面电荷。",
      "section": "场路联系",
      "prerequisites": [
        "charge-continuity",
        "constitutive-model"
      ],
      "type": "example",
      "source": "ppt",
      "anchors": {
        "36": "p36-ODE"
      }
    },
    {
      "id": "interface-method",
      "label": "跨界积分提取边界条件",
      "pages": [
        37
      ],
      "summary": "界面两侧材料不同，逐点光滑微分式不能直接跨跳变使用。薄矩形回路提取切向差，薄柱体提取法向差；界面源需保留而不是随几何厚度一起误删。",
      "section": "边界与分区",
      "prerequisites": [
        "maxwell-constraints"
      ],
      "type": "method",
      "source": "ppt",
      "anchors": {
        "37": "p37-regions"
      }
    },
    {
      "id": "tangential-boundary",
      "label": "切向E与H的衔接",
      "pages": [
        38,
        40
      ],
      "summary": "对普通静止界面和有界相应场作小回路极限，电场切向连续，磁场切向跳变由自由面电流给出。统一两侧法向和叉乘次序，H的矢量跳量不能直接当成与面电流同向。",
      "section": "边界与分区",
      "prerequisites": [
        "interface-method"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "38": "p38-E",
        "40": "p40-H"
      }
    },
    {
      "id": "normal-boundary",
      "label": "法向D、B与自由面电荷",
      "pages": [
        39,
        40
      ],
      "summary": "薄柱两底外法向相反，D的法向跳量由自由面电荷给出，B法向连续。D已包含极化响应，不能再把全部束缚电荷重复加入自由面源；连续的是指定分量而非整个矢量。",
      "section": "边界与分区",
      "prerequisites": [
        "interface-method"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "39": "p39-D",
        "40": "p40-normal"
      }
    },
    {
      "id": "boundary-compatibility",
      "label": "切向条件何时保持法向约束",
      "pages": [
        41
      ],
      "summary": "结合两侧场方程及面源守恒，切向匹配使相应法向约束差的时间导数为零。还需正确初值，或限定非零频率相量才能消掉静态差；不能无条件删去法向检查。",
      "section": "边界与分区",
      "prerequisites": [
        "tangential-boundary",
        "normal-boundary",
        "charge-continuity"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "41": "p41-B"
      }
    },
    {
      "id": "dielectric-interface",
      "label": "无自由面源的介质界面",
      "pages": [
        42
      ],
      "summary": "理想介质与“没有自由面源”是两层假设。无自由面电荷/电流时Et、Ht、Dn、Bn连续，但材料参数不同可使其他分量跳变；不能笼统说所有场分量都连续。",
      "section": "边界与分区",
      "prerequisites": [
        "tangential-boundary",
        "normal-boundary",
        "constitutive-model"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "42": "p42-model"
      }
    },
    {
      "id": "pec-interface",
      "label": "理想导体外侧场的方向",
      "pages": [
        43
      ],
      "summary": "静止理想导体中E为零；B为零还需初始无磁场等条件，不能只靠无限电导率推出。该模型下外侧电场法向、磁场切向，分别与自由面电荷及面电流相接，口诀不适用于任意有限导体。",
      "section": "边界与分区",
      "prerequisites": [
        "tangential-boundary",
        "normal-boundary"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "43": "p43-model"
      }
    },
    {
      "id": "coax-boundary-check",
      "label": "同轴四区解的界面核验",
      "pages": [
        44,
        45,
        46
      ],
      "summary": "使用有限电导率直流体电流模型所得分区场，在三个半径处逐侧取极限，检查无额外面电流时H切向相接。场为环向故B法向为零，磁导率不同不破坏这个法向条件。",
      "section": "边界与分区",
      "prerequisites": [
        "coax-magnetostatic",
        "tangential-boundary",
        "normal-boundary"
      ],
      "type": "example",
      "source": "ppt",
      "anchors": {
        "44": "p44-fullcurrent",
        "45": "p45-r4",
        "46": "p46-a"
      }
    },
    {
      "id": "poynting-derivation",
      "label": "从旋度方程推导能量关系",
      "pages": [
        47
      ],
      "summary": "展开div(E×H)，分别代入两条旋度方程，得到能流散度、场对电流做功及场响应时间项。先建立一般功率平衡，再凭材料假设把相应项解释为储能或耗散。",
      "section": "能量与唯一性",
      "prerequisites": [
        "maxwell-constraints"
      ],
      "type": "method",
      "source": "ppt",
      "anchors": {
        "47": "p47-purpose"
      }
    },
    {
      "id": "storage-dissipation",
      "label": "储能、耗散与流入功率",
      "pages": [
        48
      ],
      "summary": "固定实参数、线性无色散简单媒质中，储能含1/2 εE²与1/2 μH²；欧姆传导给σE²耗散。外法向定义流出，取负号才是流入；一般J·E不能不分来源一概叫焦耳热。",
      "section": "能量与唯一性",
      "prerequisites": [
        "poynting-derivation",
        "constitutive-model"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "48": "p48-electric"
      }
    },
    {
      "id": "poynting-vector",
      "label": "能流密度与过面功率",
      "pages": [
        49
      ],
      "summary": "S=E×H的单位为W/m²，右手规则给瞬时能流方向。对有向面积取法向投影积分才得到功率，再对时间积分才是能量；不是所有曲面都能直接以S的模乘面积。",
      "section": "能量与唯一性",
      "prerequisites": [
        "storage-dissipation"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "49": "p49-definition"
      }
    },
    {
      "id": "coax-power",
      "label": "同轴介质中的轴向功率UI",
      "pages": [
        50
      ],
      "summary": "理想同轴模型中径向E与环向H给轴向能流，对整个介质环形截面积分得UI。实际导体因有限电导率出现轴向E，可另有径向能流进入金属形成损耗，不能把理想结论无限外推。",
      "section": "能量与唯一性",
      "prerequisites": [
        "coax-electric",
        "coax-magnetostatic",
        "poynting-vector"
      ],
      "type": "example",
      "source": "ppt",
      "anchors": {
        "50": "p50-setup"
      }
    },
    {
      "id": "wire-joule",
      "label": "流入导线的场功率与I²R",
      "pages": [
        51
      ],
      "summary": "均匀稳恒体电流模型中，轴向电场与环向磁场使能流径向进入导体。侧面流入功率等于体内欧姆耗散积分及I²R；功率、能量和体功率密度的单位必须分开。",
      "section": "能量与唯一性",
      "prerequisites": [
        "poynting-vector",
        "constitutive-model"
      ],
      "type": "example",
      "source": "ppt",
      "anchors": {
        "51": "p51-r1"
      }
    },
    {
      "id": "electric-method-choice",
      "label": "按已知量选择求E的方法",
      "pages": [
        52
      ],
      "summary": "高斯定律先问对称性；电压先写路径积分，只有均匀合适方向才可用U/d；已知当地传导电流时再用适用欧姆本构反求E。三条关系不能脱离条件机械互换。",
      "section": "场路联系",
      "prerequisites": [
        "gauss-method",
        "field-circuit",
        "constitutive-model"
      ],
      "type": "method",
      "source": "ppt",
      "anchors": {
        "52": "p52-r4"
      }
    },
    {
      "id": "uniqueness-data",
      "label": "唯一性先固定同一个问题",
      "pages": [
        54
      ],
      "summary": "比较两个解时必须同区域、同媒质、同外加源、同初始场及适当外边界数据。线性正储能、非负耗散模型下以差场构造无外加源问题；唯一性是至多一个解，不证明任意数据都有解。",
      "section": "能量与唯一性",
      "prerequisites": [
        "storage-dissipation",
        "boundary-compatibility"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "54": "p54-r1"
      }
    },
    {
      "id": "uniqueness-energy",
      "label": "差场零初能量的积分证明",
      "pages": [
        55
      ],
      "summary": "相同切向边界数据使差场净能流为零，但能量导数并非非负，不能直接由导数加耗散为零令二者分别为零。须从零初始差能量积分，再用当前能量与累计耗散非负推出两场差都为零。",
      "section": "能量与唯一性",
      "prerequisites": [
        "uniqueness-data"
      ],
      "type": "method",
      "source": "ppt",
      "anchors": {
        "55": "p55-r1"
      }
    },
    {
      "id": "outer-interface-distinction",
      "label": "外边界给定与材料界面匹配",
      "pages": [
        56
      ],
      "summary": "外边界可整体给Et、整体给Ht，或按覆盖全边界的分片各给完整切向投影。材料界面同时匹配E、H不等于任意独立指定两套外边界数据；单个任意标量切向分量也不自动足够。",
      "section": "能量与唯一性",
      "prerequisites": [
        "uniqueness-energy",
        "tangential-boundary"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "56": "p56-r1"
      }
    }
  ],
