      }
    },
    {
      "id": "historical-scope",
      "label": "通信演进与趋势的适用范围",
      "pages": [
        9,
        12
      ],
      "summary": "从传播距离、复制规模和处理能力理解技术演进；原课件的数字化、光纤及移动通信趋势是历史描述，不能当作今天的市场或网络结构统计。",
      "prerequisites": [
        "message-information-signal"
      ],
      "section": "系统模型与表示",
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "9": "communications-ch1-deep-p9",
        "12": "communications-ch1-deep-p12"
      }
    },
    {
      "id": "effectiveness-reliability",
      "label": "有效性、可靠性与资源折中",
      "pages": [
        10,
        11,
        26,
        34
      ],
      "summary": "有效性看速率及频谱效率，可靠性看误差或失真；比较时固定带宽、功率和业务目标。容量约束可靠速率，但不保证任意有限码长实现都能达到。",
      "prerequisites": [
        "message-information-signal"
      ],
      "section": "系统模型与表示",
      "type": "concept",
      "source": "ppt",
