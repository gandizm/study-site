    {
      "id": "message-information-signal",
      "label": "消息、信息、信号与信源",
      "pages": [
        8,
        35,
        36
      ],
      "summary": "消息是表达对象，信号是物理载体，信源是生成消息的机制；信息论度量接收前的不确定性，不把语义价值或文件长度直接当成信息量。",
      "prerequisites": [
        "study-contract"
      ],
      "section": "系统模型与表示",
      "type": "concept",
      "source": "ppt",
      "anchors": {
