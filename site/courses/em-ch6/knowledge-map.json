      }
    },
    {
      "id": "standing-power-current",
      "label": "面电流与驻波瞬时能流",
      "pages": [
        11,
        12
      ],
      "summary": "总表面H决定非零感应面电流。纯驻波周期平均能流为零，但瞬时E×H随位置和时间往复，含2ω变化，不能说任何时刻都没有能量运动。",
      "section": "垂直入射",
      "prerequisites": [
        "standing-nodes"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "11": "p11-r1",
        "12": "p12-r1"
      }
    },
    {
      "id": "standing-energy",
      "label": "驻波储能不能套行波逐点等分",
      "pages": [
        13
      ],
      "summary": "驻波电能与磁能随空间和时间分布交替，某个固定位置一般不相等。讨论一半电能一半磁能必须明确空间积分或时间平均范围，不能把无损单一行波的逐点关系直接移来。",
      "section": "垂直入射",
      "prerequisites": [
        "standing-power-current"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "13": "p13-r1"
      }
    },
    {
      "id": "normal-fresnel",
      "label": "介质正入射的两条振幅方程",
      "pages": [
        14,
        15
      ],
      "summary": "透射场使用第二媒质波数和阻抗，无自由面源时匹配总切向E与H。电场相加、磁场因反向传播相减，得到振幅反透射系数；T=1+R在此同基矢约定成立，不是功率关系。",
      "section": "垂直入射",
      "prerequisites": [
        "reflected-h-sign"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "14": "p14-r1",
        "15": "p15-r1"
      }
    },
    {
      "id": "partial-standing",
      "label": "部分反射的行驻波包络",
      "pages": [
        16,
        17,
        18
      ],
      "summary": "入射反射幅度不等时最小值通常非零，包络最大/最小为振幅和/差。原页节点位置沿用特定负实反射系数与媒质顺序；场可线性分解，功率却不能遗漏交叉项直接分块相加。",
      "section": "垂直入射",
      "prerequisites": [
        "normal-fresnel",
        "standing-nodes"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "16": "p16-r1",
        "17": "p17-r1",
        "18": "p18-r1"
      }
    },
    {
      "id": "vswr",
      "label": "驻波比只给反射系数的模",
      "pages": [
        20
      ],
      "summary": "VSWR=(1+|R|)/(1−|R|)，匹配时为1、完全反射趋无穷。它不确定R的相位或正负；测得幅度比也不能直接作为透射功率百分比。",
      "section": "垂直入射",
      "prerequisites": [
        "partial-standing"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "20": "p20-r1"
      }
    },
    {
      "id": "normal-power-balance",
      "label": "正入射功率须加阻抗因子",
      "pages": [
        21,
        22
      ],
      "summary": "媒质1净功率为入射减反射，正的反射比例为|R|²，透射比例含η1/η2乘|T|²。无耗界面相加为1是强验算条件，反射矢量方向与正的功率百分比要分开。",
      "section": "垂直入射",
      "prerequisites": [
        "normal-fresnel"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "21": "p21-r1",
        "22": "p22-r1"
      }
    },
    {
      "id": "circular-normal-example",
      "label": "圆极化正入射的反透射",
      "pages": [
        23,
        24,
        25
      ],
      "summary": "法向入射对两切向分量作用相同，例中反射场系数−1/2、透射1/2而功率为1/4与3/4。两波仍圆极化，反射手性须结合传播方向反转判断，透射幅度减半不等于功率剩四分之一。",
      "section": "垂直入射",
      "prerequisites": [
        "normal-power-balance"
      ],
      "type": "example",
      "source": "ppt",
      "anchors": {
        "23": "p23-r1",
        "24": "p24-r1",
        "25": "p25-r1"
      }
    },
    {
      "id": "wavevector",
      "label": "任意方向的波矢与等相位面",
      "pages": [
        26,
        27
      ],
      "summary": "传播指数用k·r，坐标系数即波矢分量，其模给角波数、归一化给传播方向。位置矢量不必平行波矢，电场方向又须满足横向性，不能把两种方向余弦混用。",
      "section": "任意方向与斜入射",
      "prerequisites": [],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "26": "p26-r1",
        "27": "p27-r1"
      }
    },
    {
      "id": "plane-wave-algebra",
      "label": "单平面波的Maxwell代数化",
      "pages": [
        28,
        29
      ],
      "summary": "仅对共享平面波因子的场可把空间微分作用写成−jk，配合横向约束和阻抗求两场。无损单行波平均能流沿传播方向，场强平方须用共轭模平方和，圆/椭圆极化同样适用。",
      "section": "任意方向与斜入射",
      "prerequisites": [
        "wavevector"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "28": "p28-r1",
        "29": "p29-r1"
      }
    },
    {
      "id": "wavevector-example",
      "label": "由磁场指数求方向、系数与E",
      "pages": [
        30,
        31
      ],
      "summary": "先由指数读波矢、模与波长，再由k·H=0解未知分量，最后用叉乘恢复E。角度须对归一化方向取投影，单位从微安每米乘欧姆得到微伏每米，结果再核横向性。",
      "section": "任意方向与斜入射",
      "prerequisites": [
        "plane-wave-algebra"
      ],
      "type": "example",
      "source": "ppt",
      "anchors": {
        "30": "p30-r1",
        "31": "p31-r1"
      }
    },
    {
      "id": "te-tm-definition",
      "label": "入射面定义TE与TM",
      "pages": [
        32,
        33
      ],
      "summary": "入射面由射线和法线张成，TE电场垂直该面、TM电场位于该面但仍垂直自己的传播方向。“垂直极化”不是“垂直入射”，任意入射极化先按这两基分解。",
      "section": "理想导体斜入射",
      "prerequisites": [
        "wavevector"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "32": "p32-r1",
        "33": "p33-r1"
      }
    },
    {
      "id": "pec-te-reflection",
      "label": "TE的相位匹配与−1反射",
      "pages": [
        34,
        46
      ],
      "summary": "PEC边界须对所有切向位置成立，使切向波矢保持、法向波矢反号并给反射定律；TE振幅系数−1再实现切向E相消。波矢、基矢、幅度三处符号不能混成所有分量一律变号。",
      "section": "理想导体斜入射",
      "prerequisites": [
        "te-tm-definition",
        "pec-normal-model"
      ],
