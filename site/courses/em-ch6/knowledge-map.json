      "anchors": {
        "34": "p34-r1",
        "46": "p46-r1"
      }
    },
    {
      "id": "te-composite",
      "label": "TE合成场的法向驻波与切向行波",
      "pages": [
        35,
        36
      ],
      "summary": "入射反射叠加后，共同切向相位推进，法向振幅按k cosθ的正弦/余弦固定分布。节点间距由法向波数决定，H含沿合成传播方向的纵向分量，不能删掉后套TEM公式。",
      "section": "理想导体斜入射",
      "prerequisites": [
        "pec-te-reflection"
      ],
