      }
    },
    {
      "id": "pec-standing-fields",
      "label": "等幅反相电场合成纯驻波",
      "pages": [
        5
      ],
      "summary": "PEC界面电场反射系数为−1，两反向波叠加为电场正弦、磁场余弦空间包络。恢复时域后两场还差四分之一周期，不能只从相量包络判断瞬时场。",
      "section": "垂直入射",
      "prerequisites": [
        "reflected-h-sign"
      ],
      "type": "concept",
      "source": "ppt",
      "anchors": {
        "5": "p05-r1"
      }
    },
    {
      "id": "standing-nodes",
      "label": "固定波节与电磁包络交错",
      "pages": [
        6,
        7,
        8,
        9
      ],
      "summary": "相邻E波节相距λ/2、相邻波节与波腹相距λ/4，H包络极值与E交错。界面E为零而H加倍；快照只改变固定空间函数的系数，驻波不整体平移，波腹也不是每一时刻最大。",
      "section": "垂直入射",
      "prerequisites": [
        "pec-standing-fields"
      ],
      "type": "concept",
