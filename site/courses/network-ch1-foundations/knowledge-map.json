        94
      ],
      "summary": "比特率数每秒发送比特，单比特持续时间为其倒数；提高速率不等于提高介质传播速度。",
      "prerequisites": [
        "metrics"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    },
    {
      "id": "bandwidth",
      "label": "Hz带宽与bit/s带宽",
      "pages": [
        93
      ],
      "summary": "频率带宽和数字链路能力常共用带宽一词但单位不同，不能省掉调制和信道条件直接换算。",
      "prerequisites": [
        "rate"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    },
    {
      "id": "throughput",
      "label": "吞吐量与有效吞吐量",
      "pages": [
        95
      ],
      "summary": "吞吐量是实际通过量除时间；计入全部链路数据还是有用应用载荷会得到不同口径。",
      "prerequisites": [
        "metrics",
        "rate"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    },
    {
      "id": "transmission",
      "label": "发送时延L/R",
      "pages": [
        96
      ],
      "summary": "分组长度除发送速率得到把最后一位推出发送器的时间，与传播距离不是同一因素。",
      "prerequisites": [
        "rate"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    },
    {
      "id": "propagation",
      "label": "传播时延d/v",
      "pages": [
        97
      ],
      "summary": "信号跨链路的传播时间由距离和介质传播速度决定，最后一位发出后仍可能在路上。",
      "prerequisites": [
        "physical-layer"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    },
    {
      "id": "waiting",
      "label": "处理与排队时间",
      "pages": [
        98
      ],
      "summary": "节点处理和等待出口属于发送开始前的耗时，不能都并入L/R或忽略负载波动。",
      "prerequisites": [
        "tradeoff"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    },
    {
      "id": "latency",
      "label": "单向总时延与RTT",
      "pages": [
        99
      ],
      "summary": "各不重叠时延按路径累加；RTT跨去回程，只有特定对称近似才等于两倍传播时延。",
      "prerequisites": [
        "transmission",
        "propagation",
        "waiting"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    },
    {
      "id": "bdp",
      "label": "传播时延带宽积",
      "pages": [
        100
      ],
      "summary": "发送速率乘单向传播时延得到连续发送时在途比特量，单位是bit，不能悄换成RTT窗口口径。",
      "prerequisites": [
        "rate",
        "propagation"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    },
    {
      "id": "utilization",
      "label": "利用率与模型内时延曲线",
      "pages": [
        101
      ],
      "summary": "忙时比例是利用率；接近满载时的时延关系需指定稳定队列假设，不能外推成任意整网定律。",
      "prerequisites": [
        "waiting",
        "throughput"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    },
    {
      "id": "queueing",
      "label": "到达波动与服务能力",
      "pages": [
        102,
        103
      ],
      "summary": "系统包含等待和服务，队列人数不含正在服务者；平均到达率不同于满负荷服务能力，随机假设须另说明。",
      "prerequisites": [
        "latency",
        "utilization"
      ],
      "section": "性能与排队",
      "type": "concept",
      "source": "ppt"
    }
